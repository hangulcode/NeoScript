      <!-- PGO 3단계를 커맨드라인에서 전환한다. 기본은 평소의 /LTCG.
           계측 : /p:NeoLtcgMode=PGInstrument  → 실행해서 .pgc 수집
           최적화: /p:NeoLtcgMode=PGOptimization (pgomgr 로 병합한 .pgd 소비) -->
      <LinkTimeCodeGeneration Condition="'$(NeoLtcgMode)'==''">UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <LinkTimeCodeGeneration Condition="'$(NeoLtcgMode)'!=''">$(NeoLtcgMode)</LinkTimeCodeGeneration>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
    <PostBuildEvent>
      <!-- Copy the release console into GameDesign (sibling repository) so content machines without Visual Studio can run headless tests.
           Skipped when GameDesign is not next to this repository; a failed copy (file in use) only warns. -->
      <Command>set "NEO_BACKUP=$(ProjectDir)..\..\..\GameDesign\PDev\backup\Tools"
if exist "%NEO_BACKUP%\" (
  copy /Y "$(TargetPath)" "%NEO_BACKUP%\console.exe" &gt;nul
  copy /Y "$(ProjectDir)..\..\THIRD_PARTY_NOTICES.txt" "%NEO_BACKUP%\NEOSCRIPT_THIRD_PARTY_NOTICES.txt" &gt;nul
  copy /Y "$(ProjectDir)..\..\LICENSE" "%NEO_BACKUP%\NEOSCRIPT_LICENSE.txt" &gt;nul
  if errorlevel 1 (echo warning: could not copy console.exe to %NEO_BACKUP%) else (echo console.exe copied to %NEO_BACKUP%)
) else (
  echo GameDesign backup folder not found - console.exe not copied
)
exit /b 0</Command>
      <Message>Copy console.exe to GameDesign/PDev/backup/Tools</Message>
    </PostBuildEvent>
