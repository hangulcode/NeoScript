// ============================================================================
// NeoScript 내장 자료구조 변형 벤치
//
// bench.ns 에서 리스트를 쓰는 두 벤치만 내장 자료구조로 바꾼 판이다.
// 알고리즘과 반복량, 체크섬은 bench.ns / bench.lua / bench.cpp 와 같다.
//  - array_rw      : 정수 리스트 -> system.array(0, size)
//  - particles     : float 리스트 4개 -> system.array(0.0, count) 4개
//  - particles_vec : 위치·속도를 Vector2 배열 2개로 묶은 판
// ============================================================================
import math;
import system;

var REPS = 5;

// -------------------------------------------------------- 5. 배열 순차 쓰기/읽기
fun ArrayRW(var size, var reps)
{
    var a = system.array(0, size);
    var last = 0;
    for (var r in 0, reps, 1)
    {
        var bias = last & 1;           // 직전 결과 의존
        for (var i in 0, size, 1)
            a[i] = (i + bias) & 255;
        var sum = 0;
        for (var i in 0, size, 1)
            sum += a[i];
        last = sum;
    }
    return last;
}

// ------------------------------------------- 8. 파티클 시뮬 (float 배열 4개)
fun Particles(var count, var steps)
{
    var px = system.array(0.0, count);
    var py = system.array(0.0, count);
    var vx = system.array(0.0, count);
    var vy = system.array(0.0, count);

    for (var i in 0, count, 1)
    {
        px[i] = (i & 63) * 1.0;
        py[i] = (i & 31) * 1.0;
        vx[i] = ((i & 7) - 4) * 0.25;
        vy[i] = ((i & 15) - 8) * 0.125;
    }

    var dt = 0.015625;   // 1/64
    for (var s in 0, steps, 1)
    {
        for (var i in 0, count, 1)
        {
            var nx = px[i] + vx[i] * dt;
            var ny = py[i] + vy[i] * dt;
            if (nx < 0.0 || nx > 64.0)
                vx[i] = -vx[i];
            if (ny < 0.0 || ny > 32.0)
                vy[i] = -vy[i];
            px[i] = nx;
            py[i] = ny;
        }
    }

    var chk = 0;
    for (var i in 0, count, 1)
        chk += toint(px[i] + py[i] + 1000.0);
    return chk;
}

// ------------------------------------------- 8b. 파티클 시뮬 (Vector2 배열 2개)
// 성분별 연산 순서가 위와 같아서(px + vx*dt) 체크섬도 같다.
fun ParticlesVec(var count, var steps)
{
    var zero = math.Vector2(0.0, 0.0);
    var pos = system.array(zero, count);
    var vel = system.array(zero, count);

    for (var i in 0, count, 1)
    {
        pos[i] = math.Vector2((i & 63) * 1.0, (i & 31) * 1.0);
        vel[i] = math.Vector2(((i & 7) - 4) * 0.25, ((i & 15) - 8) * 0.125);
    }

    var dt = 0.015625;   // 1/64
    for (var s in 0, steps, 1)
    {
        for (var i in 0, count, 1)
        {
            var p = pos[i] + vel[i] * dt;
            var x = p[0];                  // 성분을 지역에 꺼내야 두 비교가 범위 점프 하나로 합쳐진다
            var y = p[1];
            if (x < 0.0 || x > 64.0)
                vel[i][0] = -vel[i][0];
            if (y < 0.0 || y > 32.0)
                vel[i][1] = -vel[i][1];
            pos[i] = p;
        }
    }

    var chk = 0;
    for (var i in 0, count, 1)
    {
        var p = pos[i];
        chk += toint(p[0] + p[1] + 1000.0);
    }
    return chk;
}

// ============================================================================
fun Report(var name, var best, var chk)
{
    print(name .. "|" .. toint(best * 1000000.0) .. "|" .. chk);
}

print("# neo dense bench begin");
var best;
var chk;

ArrayRW(1000, 1);
best = 1000000.0; chk = 0;
for (var r in 0, REPS, 1)
{
    var t = system.clock();
    chk = ArrayRW(200000, 20);
    var e = system.clock() - t;
    if (e < best) best = e;
}
Report("array_rw", best, chk);

Particles(100, 2);
best = 1000000.0;
for (var r in 0, REPS, 1)
{
    var t = system.clock();
    chk = Particles(10000, 200);
    var e = system.clock() - t;
    if (e < best) best = e;
}
Report("particles", best, chk);

ParticlesVec(100, 2);
best = 1000000.0;
for (var r in 0, REPS, 1)
{
    var t = system.clock();
    chk = ParticlesVec(10000, 200);
    var e = system.clock() - t;
    if (e < best) best = e;
}
Report("particles_vec", best, chk);
print("# neo dense bench end");
