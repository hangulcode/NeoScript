// Format script values recursively for diagnostic output.

fun object(var o)
{
	var first = true;

	var t = type(o);
    if( t == "map")
	{
        var s = "{";
        foreach(var k, v in o)
		{
            // Quote non-integer keys to distinguish them from numeric keys.
            if( type(k) != "int" )
                k = " "..k.. " " ;
			if(first)
			{
				first = false;
				s = s .. "^".. k .." = " .. object(v);
			}
			else
				s = s .. ", ^".. k .." = " .. object(v);
        }
        return s .. "}";
	}
    else if(t == "list")
	{
        var s = "[";
        foreach(var v in o)
		{
			if(first)
			{
				first = false;
				s = s .. object(v);
			}
			else
				s = s .. ", ".. object(v);
        }
        return s .. "]";
	}
    else if(t == "set")
	{
        var s = "(";
        foreach(var k in o)
		{
			if(first)
			{
				first = false;
				s = s .. object(k);
			}
			else
				s = s .. ", ".. object(k);
        }
        return s .. ")";
	}
    else
        return tostring(o);
}
