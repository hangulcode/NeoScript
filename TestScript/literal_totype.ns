// 리스트/맵 리터럴 안에서 변환 토큰(toint/tofloat/tostring/tosize/gettype)이
// 원소로 살아남는지 검증한다.
//
// 회귀 배경: 이 토큰들은 함수가 아니라 TK_TOINT 같은 토큰이고 NOP_TOINT 옵코드로 컴파일된다.
// ParseJob 의 해당 case 가 피연산자에 -1 을 먼저 대입했는데, SOperand(int) 생성자가 그걸
// "값 없음"(Data_None)으로 잡아버려서 값은 멀쩡한데 없는 것처럼 표시됐다.
// ParseListDef 는 그 표시를 보고 원소를 버리고 루프를 중단했고, 남은 토큰이 소비되지 않아
// 상위 파서가 어긋났다. 증상이 셋으로 갈렸다:
//   - 원소 1개  : 리스트가 빈 채로 만들어짐(len 0), 에러 없음
//   - 원소 2개+ : 에러 메시지 없는 컴파일 실패
//   - 전역      : 빈 리스트를 읽다 런타임 에러
import system;
import math;

var f = 0;
fun Chk(var n, var got, var want) { if (got != want) { print("FAIL " .. n .. " got=" .. got .. " want=" .. want); f++; } }

// --- 리스트 리터럴: 원소 1개 (예전엔 len 0 이 됐다) ---
var a = [toint(1.9)];
Chk("list_one_len", a.len(), 1);
Chk("list_one_val", a[0], 1);

// --- 리스트 리터럴: 원소 2개 이상 (예전엔 침묵 컴파일 실패) ---
var b = [toint(2.7), 0.0];
Chk("list_two_len", b.len(), 2);
Chk("list_two_v0", b[0], 2);
Chk("list_two_v1", b[1], 0.0);

// --- 변환 토큰 5종 전부 ---
var c = [toint(3.9), tofloat(4), tostring(5), tosize("abc"), type(1)];
Chk("all_len", c.len(), 5);
Chk("all_toint", c[0], 3);
Chk("all_tofloat", c[1], 4.0);
Chk("all_tostring", c[2], "5");
Chk("all_tosize", c[3], 3);
Chk("all_gettype", c[4], "int");

// --- 앞/중간/뒤 위치 모두 ---
// (리터럴에 바로 .len() 을 붙여 함수 인자로 넣는 문법은 지원하지 않아 변수로 받는다)
var pf = [toint(1.5), 9, 8];
var pm = [9, toint(1.5), 8];
var pl = [9, 8, toint(1.5)];
Chk("pos_first", pf.len(), 3);
Chk("pos_mid", pm.len(), 3);
Chk("pos_last", pl.len(), 3);
var pos = [9, toint(7.9), 8];
Chk("pos_mid_val", pos[1], 7);
Chk("pos_mid_after", pos[2], 8);

// --- 함수 안에서 (지역 스코프 경로) ---
fun InFun(var t, var v)
{
	var p = [toint(t), 0.0, v[0], v[1], v[2]];
	return p;
}
var q = InFun(6.7, math.Vector3(1.0, 2.0, 3.0));
Chk("infun_len", q.len(), 5);
Chk("infun_v0", q[0], 6);
Chk("infun_v2", q[2], 1.0);
Chk("infun_v4", q[4], 3.0);

// --- 인자로 넘긴 변수에 적용 (오염된 피연산자가 재사용되는 경로) ---
fun Twice(var t) { return [toint(t), toint(t + 1.0)]; }
var tw = Twice(1.2);
Chk("twice_len", tw.len(), 2);
Chk("twice_0", tw[0], 1);
Chk("twice_1", tw[1], 2);

// --- 중첩 리스트 ---
var nest = [[toint(1.5)], [toint(2.5), toint(3.5)]];
Chk("nest_len", nest.len(), 2);
Chk("nest_0_len", nest[0].len(), 1);
Chk("nest_1_len", nest[1].len(), 2);
Chk("nest_1_1", nest[1][1], 3);

// --- 맵 리터럴 (원래 정상이었지만 회귀 방지) ---
var m = { "a": toint(9.9), "b": tofloat(2) };
Chk("map_a", m["a"], 9);
Chk("map_b", m["b"], 2.0);
// 키 자리에도
var mk = { tostring(7): 1 };
Chk("map_key", mk["7"], 1);

// --- 함수 인자로 쓴 리터럴 ---
fun Sum(var lst) { var s = 0; for(var i in 0, lst.len(), 1) s = s + lst[toint(i)]; return s; }
var al = [toint(1.5), toint(2.5), toint(3.5)];
Chk("arg_literal", Sum(al), 6);

// --- append 로 넘긴 리터럴 ---
var holder = [];
holder.append([toint(4.4), 5]);
Chk("append_len", holder[0].len(), 2);
Chk("append_v0", holder[0][0], 4);

// --- 잘못된 리터럴을 컴파일 에러로 막게 되면서, 정상 문법까지 막히지 않았는지 확인 ---
// (잘못된 쪽 `[,]` `{"a":}` `{:1}` 은 컴파일 단계라 --compiler-error-regression 이 담당한다)
var emptyMap = {};
Chk("empty_map", emptyMap.len(), 0);
var oneMap = { "a": 1 };
Chk("one_map", oneMap["a"], 1);
var trailMap = { "a": 1, "b": 2, };
Chk("trailing_comma_map", trailMap.len(), 2);
// 콜론 없는 표기는 인덱스 키로 채우는 정상 문법이다
var idxMap = { "x", "y" };
Chk("no_colon_map", idxMap.len(), 2);
var nestMap = { "a": { "b": 1 }, "c": [1, 2] };
Chk("nested_map", nestMap["a"]["b"], 1);
Chk("nested_list", nestMap["c"].len(), 2);

// --- 빈 리스트/마지막 쉼표는 여전히 정상이어야 한다(에러 아님) ---
var el = [];
var tc = [1, 2, ];
Chk("empty_list", el.len(), 0);
Chk("trailing_comma", tc.len(), 2);

if (f == 0) print("LITERAL TOTYPE TESTS: ALL PASS"); else print("LITERAL TOTYPE: " .. f .. " FAIL");

