import system;

var firstRequest;

fun SecondComplete(var ok, var body)
{
	if (ok)
		print("async-nested: second callback");
	else
		print("async-nested: second callback failed");
}

fun FirstComplete(var ok, var body)
{
	if (!ok)
	{
		print("async-nested: first callback failed");
		return;
	}

	print("async-nested: first callback");
	var secondRequest = system.aysnc_create();
	secondRequest.get(2000, "http://127.0.0.1:18080/second", SecondComplete);
	if (!secondRequest.wait())
		print("async-nested: second wait timed out");
	secondRequest.close();
}

firstRequest = system.aysnc_create();
firstRequest.get(2000, "http://127.0.0.1:18080/first", FirstComplete);
if (!firstRequest.wait())
	print("async-nested: first wait timed out");
firstRequest.close();
print("async-nested: finished");

