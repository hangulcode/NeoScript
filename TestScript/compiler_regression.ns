// Compiler and VM regression suite.
// Run from Samples/console with: console.exe --run regression

import math;
import system;

const REG_CONST = 6 * 7;
const REG_MASK = 0x10 | 0x04;
const REG_SOURCE_LINE = __LINE__;
const REG_HEX_MAX = 0xffffffff;   // 32-bit two's complement -> -1
const REG_HEX_MIN = 0x80000000;   // -2147483648
const REG_EXP = 1.2e3;            // exponent literal via const/define path

var regressionTotal = 0;
var regressionPassed = 0;
var regressionFailed = 0;
var shortCircuitCalls = 0;

var RegressionShared =
{
    "ResetSerial": 0,
    "WebHitSerial": 0,
    "WebSlowdownTime": 0.0,
    "EnemyTargets": [],
    "EnemyDestroyRequests": []
};

fun Check(var ok, var line)
{
    regressionTotal += 1;
    if (ok)
        regressionPassed += 1;
    else
    {
        regressionFailed += 1;
        print("Compiler regression failure #" .. regressionTotal .. " at line " .. line);
    }
}

fun Add3(var a, var b, var c)
{
    return a + b + c;
}

fun Identity(var value)
{
    return value;
}

fun MakePair(var a, var b)
{
    return [a, b];
}

fun MakeMatrix()
{
    return [[10, 11], [20, 21]];
}

fun BuildNested(var depth)
{
    if (depth == 0)
        return [0];
    return [depth, BuildNested(depth - 1)];
}

fun ReturnMatrixCell(var matrix, var row, var column)
{
    return matrix[row][column];
}

fun Fibonacci(var n)
{
    if (n < 2)
        return n;
    return Fibonacci(n - 1) + Fibonacci(n - 2);
}

fun SafeNullAccess(var target)
{
    return target == null || target[4] < 0.3;
}

fun Increment(var value)
{
    return value + 1;
}

fun MakeFunctionList()
{
    return [Increment, fun(var value) { return value * 2; }];
}

fun MakeCallbackHolder()
{
    return { "callback": Increment, "value": 41 };
}

fun ReturnCallback(var callback)
{
    return callback;
}

fun MarkShortCircuitCall()
{
    shortCircuitCalls += 1;
    return true;
}

fun Apply(var value, var callback)
{
    return callback(value);
}

fun ReturnFromBranch(var value)
{
    if (value < 0)
        return value * -1;
    else if (value == 0)
        return 100;
    return value + 10;
}

var RegressionGlobalValue = REG_CONST;
var RegressionGlobalTable = { "value": RegressionGlobalValue, "pair": [1, 2] };
var RegressionGlobalCallback = Increment;
var RegressionGlobalComposite = { "callback": RegressionGlobalCallback, "nested": [RegressionGlobalValue, 84] };

fun TestExpressions()
{
    var a = 10;
    a = a + 3;
    Check(a == 13, __LINE__);
    a += 7;
    Check(a == 20, __LINE__);
    a -= 5;
    Check(a == 15, __LINE__);
    Check(1 + 2 * 3 == 7, __LINE__);
    Check((1 + 2) * 3 == 9, __LINE__);
    Check(17 % 5 == 2, __LINE__);
    Check((3 << 2) == 12, __LINE__);
    Check((12 >> 2) == 3, __LINE__);
    Check((5 & 3) == 1, __LINE__);
    Check((5 | 2) == 7, __LINE__);
    Check((5 ^ 3) == 6, __LINE__);
    Check(-5 + 10 == 5, __LINE__);
    Check(REG_MASK == 20, __LINE__);
    Check(!(1 == 2), __LINE__);
    Check(!(a == 14), __LINE__);
    Check(REG_CONST == 42, __LINE__);
    Check(tostring(123) == "123", __LINE__);
    Check(toint(3.9) == 3, __LINE__);
    Check(tofloat(3) == 3.0, __LINE__);
    Check(tosize("neo") == 3, __LINE__);
    Check("Neo" .. "Script" == "NeoScript", __LINE__);
    // 숫자 fast path와 분리된 문자열 비교 경로.
    Check("alpha" < "beta", __LINE__);
    Check("beta" >= "beta", __LINE__);
    Check(REG_SOURCE_LINE > 0, __LINE__);
}

fun TestAssignmentsAndBranches()
{
    var value = 20;
    value *= 3;
    Check(value == 60, __LINE__);
    value /= 4;
    Check(value == 15, __LINE__);
    value %= 4;
    Check(value == 3, __LINE__);
    value <<= 3;
    Check(value == 24, __LINE__);
    value >>= 2;
    Check(value == 6, __LINE__);
    value &= 5;
    Check(value == 4, __LINE__);
    value |= 2;
    Check(value == 6, __LINE__);
    value ^= 3;
    Check(value == 5, __LINE__);
    value++;
    Check(value == 6, __LINE__);
    value--;
    Check(value == 5, __LINE__);
    var selected = 0;
    if (value < 0)
        selected = 1;
    else if (value == 5)
        selected = 2;
    else
        selected = 3;
    Check(selected == 2, __LINE__);
    var nested = 0;
    if (true)
    {
        if (false)
            nested = 1;
        else
            nested = 7;
    }
    Check(nested == 7, __LINE__);
    Check(true && true, __LINE__);
    Check(true && false == false, __LINE__);
    Check(false || true, __LINE__);
    Check((false || true) && true, __LINE__);
    /* The lexer must preserve surrounding statement boundaries. */
    Check(value == 5, __LINE__);
}

fun TestStrings()
{
    var text = "Neo Script";
    Check(text.len() == 10, __LINE__);
    Check(text.find("Script") == 4, __LINE__);
    Check(text.sub(4, 6) == "Script", __LINE__);
    Check(text.upper() == "NEO SCRIPT", __LINE__);
    Check(text.lower() == "neo script", __LINE__);
    var padded = "  Neo  ";
    Check(padded.trim() == "Neo", __LINE__);
    Check(padded.ltrim() == "Neo  ", __LINE__);
    Check(padded.rtrim() == "  Neo", __LINE__);
    Check(text.replace("Script", "VM") == "Neo VM", __LINE__);
    var csv = "alpha,beta,gamma";
    var words = csv.split(",");
    Check(words.len() == 3, __LINE__);
    Check(words[0] == "alpha" && words[2] == "gamma", __LINE__);
    var copied = "";
    var characters = "abc";
    foreach(var ch in characters)
        copied = copied .. ch;
    Check(copied == "abc", __LINE__);

    var empty = "";
    Check(empty.len() == 0, __LINE__);
    Check(text.find("missing") == -1, __LINE__);
    var single = empty.split(",");
    Check(single.len() == 1 && single[0] == "", __LINE__);
    var escaped = "first\nsecond\tend";
    Check(escaped.find("second") == 6, __LINE__);
    Check(text.replace("Neo", "Neo") == "Neo Script", __LINE__);
    var repeated = "";
    for(var i in 0, 64, 1)
        repeated = repeated .. "x";
    Check(repeated.len() == 64 && repeated.find("xxxx") == 0, __LINE__);
    var utf8 = "Neo한글";
    Check(utf8.len() == 5, __LINE__);
    Check(utf8.find("글") == 4 && utf8.sub(3, 2) == "한글", __LINE__);
    var utf8Count = 0;
    foreach(var character in utf8)
        utf8Count += 1;
    Check(utf8Count == 5, __LINE__);
}

fun TestShortCircuit()
{
    var target = null;
    Check(target == null || target[4] < 0.3, __LINE__);
    Check(!(target != null && target[4] < 0.3), __LINE__);
    var direct = target == null || target[4] < 0.3;
    Check(direct, __LINE__);
    Check(Identity(target == null || target[4] < 0.3), __LINE__);
    var values = [target == null || target[4] < 0.3];
    Check(values[0], __LINE__);
    var table = { "safe": target == null || target[4] < 0.3 };
    Check(table["safe"], __LINE__);
    var indexValues = [10, 20];
    Check(indexValues[toint(target == null || target[4] < 0.3)] == 20, __LINE__);
    Check(SafeNullAccess(target), __LINE__);
    shortCircuitCalls = 0;
    Check((false && MarkShortCircuitCall()) == false, __LINE__);
    Check(true || MarkShortCircuitCall(), __LINE__);
    Check(shortCircuitCalls == 0, __LINE__);
    Check(true && MarkShortCircuitCall(), __LINE__);
    Check(false || MarkShortCircuitCall(), __LINE__);
    Check(shortCircuitCalls == 2, __LINE__);
    shortCircuitCalls = 0;
    Check(false || true && MarkShortCircuitCall(), __LINE__);
    Check((false || true) && MarkShortCircuitCall(), __LINE__);
    Check((false || false && MarkShortCircuitCall()) == false, __LINE__);
    Check(shortCircuitCalls == 2, __LINE__);
}

fun TestContainers()
{
    var emptyList = [];
    var emptyMap = {};
    Check(emptyList.len() == 0, __LINE__);
    Check(emptyMap.len() == 0, __LINE__);
    Check(RegressionShared["EnemyTargets"].len() == 0, __LINE__);
    Check(RegressionShared["EnemyDestroyRequests"].len() == 0, __LINE__);
    var matrix = [[1, 2], [3, 4], [5, 6]];
    Check(matrix[0][1] == 2, __LINE__);
    Check(matrix[2][1] == 6, __LINE__);
    matrix[1][0] = 30;
    Check(matrix[1][0] == 30, __LINE__);
    var pair = MakePair(11, 22);
    Check(pair[0] == 11 && pair[1] == 22, __LINE__);
    var map = { "alpha": 1, "nested": { "value": 7 }, "list": [9, 10] };
    Check(map["alpha"] == 1, __LINE__);
    Check(map["nested"]["value"] == 7, __LINE__);
    Check(map["list"][0] + map["list"][1] == 19, __LINE__);
    var emptyCount = 0;
    foreach(var value in emptyList)
        emptyCount += 1;
    foreach(var key, value in emptyMap)
        emptyCount += 1;
    foreach(var character in "")
        emptyCount += 1;
    Check(emptyCount == 0, __LINE__);
}

fun TestContainerOperations()
{
    var values = [1, 2, 3];
    values.append(4);
    values.append(9, 1);
    Check(values.len() == 5, __LINE__);
    Check(values[0] == 1 && values[1] == 9 && values[2] == 2 && values[4] == 4, __LINE__);
    var combined = values + [5, 6];
    Check(combined.len() == 7, __LINE__);
    Check(combined[5] == 5 && combined[6] == 6, __LINE__);
    var map = {};
    map[4] = 16;
    map["name"] = "neo";
    map.extra = 7;
    Check(map[4] == 16 && map["name"] == "neo" && map.extra == 7, __LINE__);
    map["name"] = null;
    Check(map.len() == 2, __LINE__);
    map["name"] = "restored";
    Check(map.len() == 3 && map["name"] == "restored", __LINE__);
    map["name"] = null;
    Check(map.len() == 2, __LINE__);
    var keyCount = 0;
    var valueSum = 0;
    foreach(var key, value in map)
    {
        keyCount += 1;
        valueSum += value;
    }
    Check(keyCount == 2 && valueSum == 23, __LINE__);
    var valuesTotal = 0;
    foreach(var value in map.values())
        valuesTotal += value;
    Check(valuesTotal == 23, __LINE__);
    var keyTotal = 0;
    foreach(var key in map.keys())
        keyTotal += 1;
    Check(keyTotal == 2, __LINE__);
}

fun TestIndexedAssignments()
{
    var values = [2, 3, 4];
    var index = 1;
    values[index] += 7;
    Check(values[1] == 10, __LINE__);
    values[index] *= 2;
    Check(values[1] == 20, __LINE__);
    values[index] /= 4;
    Check(values[1] == 5, __LINE__);
    values[index] %= 3;
    Check(values[1] == 2, __LINE__);
    var table = { "counter": 2, "nested": { "value": 4 }, "rows": [[1, 2], [3, 4]] };
    table["counter"] += 5;
    Check(table["counter"] == 7, __LINE__);
    table.nested["value"] *= 3;
    Check(table.nested["value"] == 12, __LINE__);
    table["rows"][1][0] += 8;
    Check(table["rows"][1][0] == 11, __LINE__);
}

fun TestFixedArrays()
{
    var bools = system.array(false, 10);
    Check(type(bools) == "array" && bools.len() == 10 && tosize(bools) == 10, __LINE__);
    bools[0] = true;
    bools[7] = true;
    bools[8] = true;
    Check(bools[0] && bools[7] && bools[8] && !bools[1] && !bools[9], __LINE__);

    // 컨테이너 읽기 하나만으로 된 조건. 위 줄은 && 가 있어 다른 경로로 컴파일되므로
    // 이것과 같이 있어야 한다 - 단독일 때 배열 객체를 검사하던 버그를 잡는다.
    var boolHit = 0;
    for (var bi in 0, 10) { if (bools[bi]) boolHit = boolHit + 1; }
    Check(boolHit == 3, __LINE__);
    var boolWhile = 0;
    while (bools[0]) { boolWhile = 1; bools[0] = false; }
    Check(boolWhile == 1, __LINE__);
    bools[0] = true;

    var boolElif = 0;
    if (false) boolElif = -1;
    else if (bools[0]) boolElif = 1;
    Check(boolElif == 1, __LINE__);

    var ints = system.array(2, 4);
    ints[0] = 1.7;
    ints[1] += 2.9;
    ++ints[2];
    var old = ints[2]++;
    --ints[2];
    Check(ints[0] == 1 && ints[1] == 4 && old == 3 && ints[2] == 3, __LINE__);

    var floats = system.array(1.5, 3);
    floats[0] = 3;
    floats[1] *= 2;
    Check(floats[0] == 3.0 && floats[1] == 3.0, __LINE__);

    var alias = ints;
    alias[3] = 9;
    Check(ints[3] == 9, __LINE__);

    var growInts = system.array(7, 0);
    growInts.append(3.8);
    growInts.append(4);
    growInts.resize(5);
    Check(growInts.len() == 5 && growInts[0] == 3 && growInts[1] == 4 && growInts[2] == 7 && growInts[4] == 7, __LINE__);
    growInts[3] = 99;
    growInts.resize(2);
    growInts.resize(4);
    Check(growInts[2] == 7 && growInts[3] == 7, __LINE__);
    var growAlias = growInts;
    growAlias.append(5);
    Check(growInts.len() == 5 && growInts[4] == 5, __LINE__);

    var growFloats = system.array(1.5, 1);
    growFloats.append(3);
    growFloats.resize(4);
    Check(growFloats[0] == 1.5 && growFloats[1] == 3.0 && growFloats[2] == 1.5 && growFloats[3] == 1.5, __LINE__);

    var growBools = system.array(true, 0);
    growBools.append(false);
    growBools.resize(10);
    Check(!growBools[0] && growBools[1] && growBools[7] && growBools[8] && growBools[9], __LINE__);
    growBools.resize(1);
    growBools.resize(9);
    Check(growBools[1] && growBools[8], __LINE__);

    var sum = 0;
    foreach(var value in ints)
        sum += value;
    Check(sum == 17, __LINE__);
}

fun TestNestedIndexExpressions()
{
    var indexList = [2, 0];
    var activeList = [false, true, true];
    Check(activeList[indexList[0]], __LINE__);

    var matrix = [[10, 11], [20, 21], [30, 31]];
    Check(matrix[indexList[0]][indexList[1]] == 30, __LINE__);
    activeList[indexList[1]] = true;
    Check(activeList[0], __LINE__);
    var functionIndices = [1, 0];
    Check(MakeMatrix()[functionIndices[0]][functionIndices[1]] == 20, __LINE__);

    // 컨테이너 읽기를 값으로 받아야 하는 자리들 — !, &&/||, sleep.
    // sleep 은 예전에 읽은 값을 버리고 컨테이너를 넘겨서 런타임에 죽었다.
    var flags = [false, true];
    Check(!flags[0], __LINE__);
    Check(flags[1] && flags[indexList[1] + 1], __LINE__);
    Check(flags[0] || flags[1], __LINE__);
    var delays = [0];
    sleep(delays[0]);
    Check(true, __LINE__);
}

fun TestScopesAndReturns()
{
    var value = 1;
    {
        var inner = value + 4;
        value = inner * 2;
        Check(value == 10, __LINE__);
    }
    Check(value == 10, __LINE__);

    var total = 0;
    for(var i in 0, 5, 1)
    {
        var loopValue = i * 3;
        total += loopValue;
    }
    Check(total == 30, __LINE__);
    Check(ReturnFromBranch(-7) == 7, __LINE__);
    Check(ReturnFromBranch(0) == 100, __LINE__);
    Check(ReturnFromBranch(32) == 42, __LINE__);
    Check(Add3(ReturnFromBranch(-1), ReturnFromBranch(0), ReturnFromBranch(1)) == 112, __LINE__);
    Check(RegressionGlobalValue == 42 && RegressionGlobalTable["pair"][1] == 2, __LINE__);
    Check(RegressionGlobalCallback(41) == 42, __LINE__);
    Check(RegressionGlobalComposite["callback"](41) == 42, __LINE__);
    Check(RegressionGlobalComposite.nested[1] == 84, __LINE__);
}

fun TestNestedControlFlow()
{
    var sum = 0;
    for(var i in 0, 4, 1)
    {
        for(var j in 0, 4, 1)
        {
            if (j == 1)
                continue;
            if (j == 3)
                break;
            sum += i * 10 + j;
        }
    }
    Check(sum == 128, __LINE__);

    sum = 0;
    for(var i in 0, 6, 1)
    {
        if (i == 2)
            continue;
        for(var j in 0, 3, 1)
        {
            if (j == 1)
                break;
            sum += i;
        }
    }
    Check(sum == 13, __LINE__);

    var target = null;
    var count = 0;
    while (count < 3 && (target == null || target[0] < 1))
        count += 1;
    Check(count == 3, __LINE__);

    var map = {};
    map["safe"] = target == null || target[0] < 1;
    Check(map["safe"], __LINE__);
}

fun TestContainerAliases()
{
    var originalList = [1, 2];
    var aliasList = originalList;
    aliasList[0] = 9;
    Check(originalList[0] == 9, __LINE__);
    originalList = originalList;
    Check(originalList[0] == 9 && originalList.len() == 2, __LINE__);

    var originalMap = { "value": 3 };
    var aliasMap = originalMap;
    aliasMap["value"] += 4;
    Check(originalMap["value"] == 7, __LINE__);
    originalMap = originalMap;
    Check(originalMap["value"] == 7, __LINE__);

    var functions = [Increment, fun(var value) { return value * 2; }];
    Check(functions[0](41) == 42, __LINE__);
    Check(functions[1](21) == 42, __LINE__);

    var dispatch = { "add": Add3, "increment": Increment };
    Check(dispatch["add"](10, 20, 12) == 42, __LINE__);
    Check(dispatch.increment(41) == 42, __LINE__);

}

fun TestComplexAccess()
{
    var matrix = [[1, 2], [3, 4], [5, 6]];
    Check(ReturnMatrixCell(matrix, 2, 1) == 6, __LINE__);
    Check(MakeMatrix()[1][0] == 20, __LINE__);
    Check(MakeFunctionList()[0](41) == 42, __LINE__);
    Check(MakeFunctionList()[1](21) == 42, __LINE__);
    Check(MakeCallbackHolder()["callback"](MakeCallbackHolder()["value"]) == 42, __LINE__);
    Check(ReturnCallback(MakeFunctionList()[0])(41) == 42, __LINE__);
    Check(BuildNested(3)[1][1][1][0] == 0, __LINE__);

    var tree =
    {
        "node":
        {
            "values": [10, 20, 30],
            "callback": Increment,
            "dispatch": { "add": Add3 }
        }
    };
    Check(tree["node"].values[1] == 20, __LINE__);
    Check(tree["node"]["callback"](41) == 42, __LINE__);
    Check(tree.node.dispatch["add"](10, 20, 12) == 42, __LINE__);

    Check(Add3(Increment(1), Add3(2, 3, 4), Fibonacci(5)) == 16, __LINE__);

    var dynamic = {};
    for(var i in 0, 16, 1)
    {
        var key = "item_" .. i;
        dynamic[key] = i * i;
    }
    var lookup = "item_" .. 9;
    Check(dynamic[lookup] == 81, __LINE__);
    Check(dynamic["item_" .. 15] == 225, __LINE__);

    var indexed = [10, 20, 30];
    var index = 0;
    Check(indexed[index += 1] == 20 && index == 1, __LINE__);

    var operands = [8, 2, 3, 5];
    var accumulator = 1;
    accumulator += operands[0];
    Check(accumulator == 9, __LINE__);
    accumulator -= operands[1];
    Check(accumulator == 7, __LINE__);
    accumulator *= operands[2];
    Check(accumulator == 21, __LINE__);
    accumulator /= operands[3];
    Check(accumulator == 4, __LINE__);
    var remainder = 23;
    remainder %= operands[3];
    Check(remainder == 3, __LINE__);
    var floatAccumulator = 21.0;
    floatAccumulator /= operands[3];
    Check(floatAccumulator == 4.2, __LINE__);
}

fun TestAllocationLifetime()
{
    var last = null;
    var sum = 0;
    for(var i in 0, 128, 1)
    {
        last = { "index": i, "pair": [i, i + 1], "text": "value_" .. i };
        sum += last["pair"][1];
    }
    Check(sum == 8256, __LINE__);
    Check(last["index"] == 127 && last["text"] == "value_127", __LINE__);

    var text = "Neo";
    text = text;
    Check(text == "Neo", __LINE__);

    var map = { "a": 1, "b": 2, "c": 3 };
    foreach(var key, value in map)
        map[key] = value * 10;
    Check(map["a"] == 10 && map["b"] == 20 && map["c"] == 30, __LINE__);
}

fun TestFunctionValues()
{
    var callback = Increment;
    Check(callback(41) == 42, __LINE__);
    Check(Apply(41, callback) == 42, __LINE__);
    var triple = fun(var value) { return value * 3; };
    Check(triple(14) == 42, __LINE__);
    var holder = {};
    holder.callback = Increment;
    Check(holder.callback(41) == 42, __LINE__);
}

fun TestLoops()
{
    var sum = 0;
    for(var i in 1, 5, 1)
        sum += i;
    Check(sum == 10, __LINE__);
    sum = 0;
    for(var i in 1, 20, 1)
    {
        if (i % 2 == 1)
            continue;
        sum += i;
    }
    Check(sum == 90, __LINE__);
    sum = 0;
    for(var i in 1, 100, 1)
    {
        if (i == 10)
            break;
        sum += i;
    }
    Check(sum == 45, __LINE__);
    var whileIndex = 0;
    sum = 0;
    while (whileIndex < 50)
    {
        sum += whileIndex;
        whileIndex += 1;
    }
    Check(sum == 1225, __LINE__);
    var groups = [[1, 2], [3, 4]];
    sum = 0;
    foreach(var value in groups[1])
        sum += value;
    Check(sum == 7, __LINE__);
}

fun TestBulk()
{
    var list = [];
    var map = {};
    var listSum = 0;

    for(var i in 1, 512, 1)
    {
        var value = i * 17 + 3;
        Check(value - 3 == i * 17, __LINE__);
        Check(value > i && value >= i, __LINE__);
        Check(value % 7 >= 0 && value % 7 < 7, __LINE__);
        list.append(i);
        map[i] = i * i;
    }

    for(var i in 1, 512, 1)
    {
        Check(list[i - 1] == i, __LINE__);
        Check(map[i] == i * i, __LINE__);
    }

    foreach(var value in list)
        listSum += value;
    Check(listSum == 130816, __LINE__);
    var mapSum = 0;
    foreach(var key, value in map)
        mapSum += value;
    Check(mapSum == 44608256, __LINE__);
}

fun TestVectorValueTypes()
{
    var a = math.Vector3(1.0, 2.0, 3.0);
    var b = math.Vector3(4.0, 5.0, 6.0);
    Check(type(a) == "Vector3", __LINE__);
    Check(tosize(a) == 3, __LINE__);
    Check(a[0] == 1.0 && a[1] == 2.0 && a[2] == 3.0, __LINE__);

    var copy = a;
    copy[0] = 9.0;
    Check(a[0] == 1.0 && copy[0] == 9.0, __LINE__);
    Check(a == math.Vector3(1.0, 2.0, 3.0), __LINE__);
    Check(a != b, __LINE__);

    var sum = a + b;
    var scaled = sum * 0.5;
    Check(sum[0] == 5.0 && sum[1] == 7.0 && sum[2] == 9.0, __LINE__);
    Check(scaled[0] == 2.5 && scaled[1] == 3.5 && scaled[2] == 4.5, __LINE__);
    Check(math.DistanceSquared3(a, b) == 27.0, __LINE__);

    var lerped = math.Lerp3(a, b, 0.5);
    Check(lerped == math.Vector3(2.5, 3.5, 4.5), __LINE__);
    var normalized = math.Normalize3(math.Vector3(0.0, 0.0, 0.0), math.Vector3(0.0, 1.0, 0.0));
    Check(normalized == math.Vector3(0.0, 1.0, 0.0), __LINE__);

    var q = math.Quaternion(1.0, 0.0, 0.0, 0.0);
    // 쿼터니언은 별도 타입이 아니다 — 4성분 벡터이며 wxyz 해석은 사용자 규약이다.
    Check(type(q) == "Vector4" && q[0] == 1.0 && q[3] == 0.0, __LINE__);
    Check(math.RotateVectorByQuat(q, a) == a, __LINE__);
}

const SWITCH_CONST_KEY = 7;

fun SwitchBasic(var value)
{
    switch (value)
    {
    case 1:
        return "one";
    case 2, 3:
        return "two-or-three";
    case "text":
        return "string";
    case true:
        return "bool";
    case SWITCH_CONST_KEY:
        return "const";
    case 4 + 5:
        return "expr";
    default:
        return "default";
    }
    return "unreachable";
}

// default 가 없으면 매칭 실패 시 switch 뒤로 진행한다.
fun SwitchNoDefault(var value)
{
    var result = "none";
    switch (value)
    {
    case 1:
        result = "one";
    }
    return result;
}

// fallthrough 가 없으므로 첫 case 본문만 실행된다.
fun SwitchNoFallthrough(var value)
{
    var text = "";
    switch (value)
    {
    case 1:
        text = text .. "A";
    case 2:
        text = text .. "B";
    default:
        text = text .. "D";
    }
    return text;
}

// switch 안의 break 는 switch 만, continue 는 바깥 loop 에 적용된다.
fun SwitchInLoop()
{
    var text = "";
    for (var i in 0, 5, 1)
    {
        switch (i)
        {
        case 1:
            continue;
        case 3:
            break;
        default:
            text = text .. i;
        }
        text = text .. "|";
    }
    return text;
}

fun SwitchNested(var outer, var inner)
{
    switch (outer)
    {
    case 1:
        switch (inner)
        {
        case 10:
            return "1-10";
        default:
            return "1-other";
        }
    case 2:
        return "2";
    }
    return "none";
}

fun TestSwitch()
{
    Check(SwitchBasic(1) == "one", __LINE__);
    Check(SwitchBasic(2) == "two-or-three", __LINE__);
    Check(SwitchBasic(3) == "two-or-three", __LINE__);
    Check(SwitchBasic("text") == "string", __LINE__);
    Check(SwitchBasic(true) == "bool", __LINE__);
    Check(SwitchBasic(SWITCH_CONST_KEY) == "const", __LINE__);
    Check(SwitchBasic(9) == "expr", __LINE__);
    Check(SwitchBasic(99) == "default", __LINE__);

    // strict type match : true != 1, "1" != 1
    Check(SwitchBasic(false) == "default", __LINE__);
    Check(SwitchBasic("1") == "default", __LINE__);

    // key 로 쓸 수 없는 타입(float 포함)은 default 로 간다
    Check(SwitchBasic(1.0) == "default", __LINE__);
    Check(SwitchBasic(2.5) == "default", __LINE__);
    Check(SwitchBasic(null) == "default", __LINE__);
    Check(SwitchBasic([1, 2]) == "default", __LINE__);
    Check(SwitchBasic({ "a": 1 }) == "default", __LINE__);

    Check(SwitchNoDefault(1) == "one", __LINE__);
    Check(SwitchNoDefault(2) == "none", __LINE__);

    Check(SwitchNoFallthrough(1) == "A", __LINE__);
    Check(SwitchNoFallthrough(2) == "B", __LINE__);
    Check(SwitchNoFallthrough(7) == "D", __LINE__);

    Check(SwitchInLoop() == "0|2||4|", __LINE__);

    Check(SwitchNested(1, 10) == "1-10", __LINE__);
    Check(SwitchNested(1, 99) == "1-other", __LINE__);
    Check(SwitchNested(2, 0) == "2", __LINE__);
    Check(SwitchNested(5, 0) == "none", __LINE__);
}

fun TestNumberLiterals()
{
    // Hex integer literals: parsed as exact int32 bit patterns (not via double).
    Check(0xffffffff == -1, __LINE__);
    Check(0x80000000 == -2147483648, __LINE__);
    Check(0x7fffffff == 2147483647, __LINE__);
    Check(0xff == 255, __LINE__);
    Check(0x100 == 256, __LINE__);
    Check(0x0 == 0, __LINE__);
    Check(-0x10 == -16, __LINE__);
    Check((0xff & 0x0f) == 0x0f, __LINE__);
    Check((0xf0 | 0x0f) == 0xff, __LINE__);
    // Hex literals through the const/define path.
    Check(REG_HEX_MAX == -1, __LINE__);
    Check(REG_HEX_MIN == -2147483648, __LINE__);

    // Exponent float literals with exact representable values.
    Check(1e0 == 1.0, __LINE__);
    Check(1e3 == 1000.0, __LINE__);
    Check(1.5e1 == 15.0, __LINE__);
    Check(2.5e2 == 250.0, __LINE__);
    Check(100 + 1.5e1 == 115.0, __LINE__);

    // Exponent float literals with rounding tolerance (1.2, 5.6, ... not exact in double).
    Check(1.2e3 > 1199.999 && 1.2e3 < 1200.001, __LINE__);
    Check(1.2e+3 > 1199.999 && 1.2e+3 < 1200.001, __LINE__);
    Check(5.6E-4 > 0.00055 && 5.6E-4 < 0.00057, __LINE__);
    Check(6.02e23 > 6.0e23 && 6.02e23 < 6.1e23, __LINE__);
    Check(3.14 > 3.13 && 3.14 < 3.15, __LINE__);
    // Exponent literal through the const/define path.
    Check(REG_EXP > 1199.999 && REG_EXP < 1200.001, __LINE__);
}

fun RegressionRun()
{
    TestExpressions();
    TestAssignmentsAndBranches();
    TestStrings();
    TestShortCircuit();
    TestContainers();
    TestContainerOperations();
    TestIndexedAssignments();
    TestFixedArrays();
    TestNestedIndexExpressions();
    TestScopesAndReturns();
    TestNestedControlFlow();
    TestContainerAliases();
    TestComplexAccess();
    TestAllocationLifetime();
    TestFunctionValues();
    TestLoops();
    TestBulk();
	TestVectorValueTypes();
    TestSwitch();
    TestNumberLiterals();
    Check(Add3(10, 20, 30) == 60, __LINE__);
    Check(Fibonacci(12) == 144, __LINE__);
    if (regressionFailed == 0)
        print("Compiler regression PASS : " .. regressionPassed .. "/" .. regressionTotal);
    else
        print("Compiler regression FAIL : " .. regressionFailed .. "/" .. regressionTotal);
}

RegressionRun();
